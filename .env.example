# Example environment variables.
# Locally these are set by docker-compose; this file documents what the
# backend service needs in Railway.
#
# In Railway, add a PostgreSQL plugin, then set these on the BACKEND service
# using variable references to the Postgres plugin:
#
#   SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#   SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
#   SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}
#   SPRING_JPA_HIBERNATE_DDL_AUTO=update
#
# PORT is injected automatically by Railway for each service.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tervisehull
SPRING_DATASOURCE_USERNAME=tervisehull
SPRING_DATASOURCE_PASSWORD=tervisehull
SPRING_JPA_HIBERNATE_DDL_AUTO=update
